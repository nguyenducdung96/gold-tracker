{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gold-tracker",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-04",

  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "VN_CONSENSUS_BAND_PCT": "6",
    "VN_OUTLIER_THRESHOLD_PCT": "8",
    "VN_MAX_SPREAD_PCT": "8",
    "VN_MIN_CONSENSUS_SIZE": "3",
    "VN_FALLBACK_VERIFY_PCT": "5",
    "VN_FALLBACK_MIN_SOURCES": "2"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gold-tracker-db",
      "database_id": "658d25ee-79f6-4f1c-9f20-5a1b9066f999"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 * * * *",
      "0 3 * * *"
    ]
  }
}
